---
interface Props {
  id: string;
  title: string;
  description: string;
  nodes: string[][];
}

const { id, title, description, nodes } = Astro.props;
const nodeWidth = 164;
const nodeHeight = 92;
const gap = 30;
const startX = 16;
const diagramWidth = startX * 2 + nodes.length * nodeWidth + (nodes.length - 1) * gap;
const mobileRowHeight = 120;
const diagramHeight = 24 + nodes.length * mobileRowHeight;
---

<figure class="architecture-figure">
  <svg
    class="diagram-wide"
    data-flow-diagram={id}
    viewBox={`0 0 ${diagramWidth} 176`}
    role="img"
    aria-labelledby={`diagram-title-${id}`}
    aria-describedby={`diagram-description-${id}`}
  >
    <title id={`diagram-title-${id}`}>{title}</title>
    <desc id={`diagram-description-${id}`}>{description}</desc>
    <defs>
      <marker id={`arrow-wide-${id}`} markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M0 0 8 4 0 8Z" class="diagram-arrow-head" />
      </marker>
    </defs>
    {nodes.map((lines, index) => {
      const x = startX + index * (nodeWidth + gap);
      const centerX = x + nodeWidth / 2;
      const firstLineY = lines.length > 2 ? 101 : lines.length > 1 ? 107 : 116;
      return (
        <g class="diagram-stage" data-diagram-stage={index} data-diagram-label={`Step ${index + 1}: ${lines.join(' ')}`}
          {index < nodes.length - 1 && (
            <path
              d={`M ${x + nodeWidth + 4} 92 H ${x + nodeWidth + gap - 5}`}
              class="diagram-arrow"
              marker-end={`url(#arrow-wide-${id})`}
            />
          )}
          <rect x={x} y="46" width={nodeWidth} height={nodeHeight} rx="14" class="diagram-node" />
          <circle cx={x + 22} cy="66" r="11" class="diagram-step" />
          <text x={x + 22} y="69.5" text-anchor="middle" class="diagram-step-number">{String(index + 1).padStart(2, '0')}</text>
          {lines.map((line, lineIndex) => (
            <text x={centerX} y={firstLineY + lineIndex * 20} text-anchor="middle" class="diagram-label">
              {line}
            </text>
          ))}
        </g>
      );
    })}
  </svg>

  <svg
    class="diagram-tall"
    data-flow-diagram={id}
    viewBox={`0 0 360 ${diagramHeight}`}
    role="img"
    aria-labelledby={`diagram-title-${id}-mobile`}
    aria-describedby={`diagram-description-${id}-mobile`}
  >
    <title id={`diagram-title-${id}-mobile`}>{title}</title>
    <desc id={`diagram-description-${id}-mobile`}>{description}</desc>
    <defs>
      <marker id={`arrow-tall-${id}`} markerWidth="8" markerHeight="8" refX="4" refY="6" orient="auto">
        <path d="M0 0 8 0 4 8Z" class="diagram-arrow-head" />
      </marker>
    </defs>
    {nodes.map((lines, index) => {
      const y = 12 + index * mobileRowHeight;
      const centerY = y + nodeHeight / 2;
      const firstLineY = lines.length > 2 ? centerY + 3 : lines.length > 1 ? centerY + 9 : centerY + 18;
      return (
        <g class="diagram-stage" data-diagram-stage={index} data-diagram-label={`Step ${index + 1}: ${lines.join(' ')}`}
          {index < nodes.length - 1 && (
            <path
              d={`M 180 ${y + nodeHeight + 4} V ${y + mobileRowHeight - 7}`}
              class="diagram-arrow"
              marker-end={`url(#arrow-tall-${id})`}
            />
          )}
          <rect x="20" y={y} width="320" height={nodeHeight} rx="14" class="diagram-node" />
          <circle cx="44" cy={y + 20} r="11" class="diagram-step" />
          <text x="44" y={y + 23.5} text-anchor="middle" class="diagram-step-number">{String(index + 1).padStart(2, '0')}</text>
          {lines.map((line, lineIndex) => (
            <text x="180" y={firstLineY + lineIndex * 20} text-anchor="middle" class="diagram-label">
              {line}
            </text>
          ))}
        </g>
      );
    })}
  </svg>
  <figcaption>{description}</figcaption>
</figure>


<script>
  const flowRoot = document.querySelector<HTMLElement>('[data-case-study-flow]');

  if (flowRoot && !flowRoot.dataset.flowInteractive) {
    flowRoot.dataset.flowInteractive = 'true';

    const stageSvgs = Array.from(flowRoot.querySelectorAll<SVGSVGElement>('[data-flow-diagram]'));
    const diagramStages = Array.from(flowRoot.querySelectorAll<SVGGElement>('[data-diagram-stage]'));
    const stepButtons = Array.from(flowRoot.querySelectorAll<HTMLButtonElement>('[data-step-control]'));
    const clearButton = flowRoot.querySelector<HTMLButtonElement>('[data-flow-clear]');
    const status = flowRoot.querySelector<HTMLElement>('[data-flow-status]');
    let selectedIndex: number | null = null;

    stageSvgs.forEach((svg) => svg.setAttribute('role', 'group'));

    diagramStages.forEach((stage) => {
      stage.setAttribute('role', 'button');
      stage.setAttribute('tabindex', '0');
      stage.setAttribute('aria-label', stage.dataset.diagramLabel ?? 'Select flow stage');
      stage.setAttribute('aria-pressed', 'false');
      stage.addEventListener('click', () => selectStage(Number(stage.dataset.diagramStage)));
      stage.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          selectStage(Number(stage.dataset.diagramStage));
        }
      });
    });

    stepButtons.forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', () => selectStage(Number(button.dataset.stepControl)));
    });

    clearButton?.addEventListener('click', () => selectStage(null));

    function selectStage(index: number | null) {
      selectedIndex = index === selectedIndex ? null : index;

      diagramStages.forEach((stage) => {
        const active = selectedIndex !== null && Number(stage.dataset.diagramStage) === selectedIndex;
        stage.classList.toggle('is-active', active);
        stage.setAttribute('aria-pressed', String(active));
      });

      stepButtons.forEach((button) => {
        const active = selectedIndex !== null && Number(button.dataset.stepControl) === selectedIndex;
        button.setAttribute('aria-pressed', String(active));
        button.closest('[data-flow-step]')?.classList.toggle('is-active', active);
      });

      if (clearButton) clearButton.hidden = selectedIndex === null;
      if (status) {
        status.textContent =
          selectedIndex === null
            ? 'Step highlight cleared.'
            : `Step ${selectedIndex + 1} highlighted in the diagram and explanation.`;
      }
    }
  }
</script>
