---
interface Props {
  homeUrl?: string;
}

const { homeUrl = '' } = Astro.props;
const sectionUrl = (section: string) => (homeUrl ? `${homeUrl}#${section}` : `#${section}`);
---

<header class="site-header wrap">
  <a class="brand" href={homeUrl || '#top'} aria-label="Pariram S, home">
    <span class="brand-mark" aria-hidden="true">P</span>
    <span>Pariram S</span>
  </a>

  <nav class="primary-nav" aria-label="Primary navigation">
    <a href={sectionUrl('work')}>Work</a>
    <a href={sectionUrl('about')}>About</a>
    <a href={sectionUrl('experience')}>Experience</a>
    <a href={sectionUrl('writing')}>Writing</a>
    <a href={sectionUrl('contact')}>Contact</a>
  </nav>

  <button
    class="theme-toggle"
    type="button"
    data-theme-toggle
    aria-label="Switch to dark theme"
    aria-pressed="false"
  >
    <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
    </svg>
    <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z" />
    </svg>
    <span class="theme-toggle-label" data-theme-label>Light mode</span>
  </button>
</header>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (themeToggle) {
    const updateThemeControl = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      themeToggle.setAttribute('aria-pressed', String(isDark));
      themeToggle.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
      const themeLabel = themeToggle.querySelector<HTMLElement>('[data-theme-label]');
      if (themeLabel) themeLabel.textContent = `${isDark ? 'Dark' : 'Light'} mode`;
    };

    updateThemeControl();
    themeToggle.addEventListener('click', () => {
      const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = nextTheme;
      try {
        window.localStorage.setItem('portfolio-theme', nextTheme);
      } catch {
        // Keep the selected theme active for this page session.
      }
      updateThemeControl();
    });
  }
</script>

