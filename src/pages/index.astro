---
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../data/experience';
import { featuredProjects, personalProjects } from '../data/projects';

const focusAreas = ['Cloud systems', 'API design', 'Event-driven integration'];
---

<BaseLayout
  title="Pariram S — Software Developer"
  description="Software developer working across cloud systems, APIs, and event-driven integration."
>
  <div id="top" class="wrap">
    <SiteHeader />

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-content">
          <p class="eyebrow">Software Developer · Cloud &amp; Integration</p>
          <h1 id="hero-title">Building reliable systems for <span>real work.</span></h1>
          <p class="hero-copy">
            I work across cloud platforms, APIs, and event-driven integration, with a focus on
            software that stays clear, dependable, and useful.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="#contact">Get in touch</a>
          </div>
          <div class="hero-case-studies">
            <p class="hero-case-studies-heading">Featured case studies <span>Choose a story to explore</span></p>
            <ul>
              {featuredProjects.map((project) => (
                <li>
                  <a href={`${import.meta.env.BASE_URL}projects/${project.caseStudySlug}/`}>
                    <strong>{project.title}</strong>
                    <span>Read case study <span aria-hidden="true">→</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

      </section>

      <section id="work" class="content-section" aria-labelledby="work-title">
        <div>
          <p class="section-kicker">01 / Selected work</p>
          <h2 id="work-title">Engineering stories, told with context.</h2>
        </div>
        <div class="work-content">
          <p class="work-intro">
            A selection of professional engineering work, followed by independent projects.
          </p>
          <div class="project-grid" aria-label="Featured professional projects">
            {featuredProjects.map((project, index) => (
              <article class="project-card project-card-featured">
                <div class="project-card-top">
                  <span class="project-category">Professional work</span>
                  <span class="project-index">0{index + 1}</span>
                </div>
                <h3 class="project-title">
                  {project.caseStudySlug ? (
                    <a href={`${import.meta.env.BASE_URL}projects/${project.caseStudySlug}/`}>
                      {project.title} <span aria-hidden="true">↗</span>
                    </a>
                  ) : project.title}
                </h3>
                <p class="project-summary">{project.summary}</p>
                <a class="case-study-card-link" href={`${import.meta.env.BASE_URL}projects/${project.caseStudySlug}/`}>
                  Read case study <span aria-hidden="true">→</span>
                </a>
                <ul class="project-technologies" aria-label={`Technologies for ${project.title}`}>
                  {project.technologies.map((technology) => <li>{technology}</li>)}
                </ul>
              </article>
            ))}
          </div>

          <div class="personal-projects">
            <div class="personal-projects-heading">
              <h3>Personal projects</h3>
              <p>Independent experiments and applications.</p>
            </div>
            <div class="project-grid project-grid-personal" aria-label="Personal projects">
              {personalProjects.map((project) => (
                <article class="project-card">
                  <span class="project-category">Personal project</span>
                  <h4 class="project-title">
                    {project.repositoryUrl ? (
                      <a href={project.repositoryUrl} target="_blank" rel="noreferrer">
                        {project.title} <span aria-hidden="true">↗</span>
                      </a>
                    ) : project.title}
                  </h4>
                  <p class="project-summary">{project.summary}</p>
                  <ul class="project-technologies" aria-label={`Technologies for ${project.title}`}>
                    {project.technologies.map((technology) => <li>{technology}</li>)}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="about" class="content-section" aria-labelledby="about-title">
        <div>
          <p class="section-kicker">02 / About</p>
          <h2 id="about-title">Thoughtful engineering, from the first request to the final result.</h2>
        </div>
        <div>
          <p class="section-copy">
            I enjoy making complex workflows easier to understand and more dependable to operate.
            My work spans backend services, cloud architecture, and integrations between systems.
          </p>
          <div class="section-aside" aria-label="Areas of focus">
            {focusAreas.map((area) => <span class="topic-chip">{area}</span>)}
          </div>
        </div>
      </section>

      <section id="experience" class="content-section" aria-labelledby="experience-title">
        <div>
          <p class="section-kicker">03 / Experience</p>
          <h2 id="experience-title">Building systems that work together.</h2>
        </div>
        <div class="experience-list">
          {experience.map((item) => (
            <article class="experience-card">
              <div class="experience-card-header">
                <div>
                  <h3>{item.role}</h3>
                  <p class="experience-company">{item.company}</p>
                  {item.current && <span class="current-role">Current role</span>}
                </div>
                <p class="experience-period">{item.period}</p>
              </div>
              <p class="experience-location">{item.location}</p>
              {item.highlights.length > 0 && (
                <ul class="experience-highlights">
                  {item.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>

      <section id="writing" class="content-section" aria-labelledby="writing-title">
        <div>
          <p class="section-kicker">04 / Writing</p>
          <h2 id="writing-title">Notes on ideas worth exploring.</h2>
        </div>
        <div>
          <p class="section-copy">
            Writing and learning on distributed systems, software design, and cloud technology will
            be gathered here.
          </p>
        </div>
      </section>

      <section id="contact" class="content-section" aria-labelledby="contact-title">
        <div>
          <p class="section-kicker">05 / Contact</p>
          <h2 id="contact-title">Let’s talk about good engineering.</h2>
        </div>
        <div class="contact-panel">
          <p>For professional conversations, email me or connect on LinkedIn.</p>
          <div class="contact-actions">
            <a class="button button-primary" href="mailto:pari.pariram.ram@gmail.com">
              pari.pariram.ram@gmail.com
            </a>
            <a
              class="button button-secondary"
              href="https://www.linkedin.com/in/pariram-s-a2367a160"
              target="_blank"
              rel="noreferrer"
            >
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
            <a
              class="button button-secondary"
              href="https://github.com/Pariram140"
              target="_blank"
              rel="noreferrer"
            >
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Pariram S</p>
      <p>Designed with clarity and care.</p>
    </footer>
  </div>
</BaseLayout>

